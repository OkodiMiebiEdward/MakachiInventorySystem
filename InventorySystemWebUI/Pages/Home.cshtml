@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<style>
    body, .dashboard-bg {
        background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 100%);
    }
    .scale-hover:hover, .scale-hover:focus {
        transform: scale(1.08);
        z-index: 2;
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    }
    .btn-dashboard {
        min-height: 90px;
        font-size: 1.15rem;
        font-weight: 500;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }
    .btn-gradient {
        background: linear-gradient(90deg, #6a11cb 0%, #2575fc 100%);
        color: #fff !important;
        border: none;
    }
    .btn-gradient:hover, .btn-gradient:focus {
        background: linear-gradient(90deg, #2575fc 0%, #6a11cb 100%);
        color: #fff !important;
    }
    .btn-orange {
        background: linear-gradient(90deg, #ff8008 0%, #ffc837 100%);
        color: #fff !important;
        border: none;
    }
    .btn-orange:hover, .btn-orange:focus {
        background: linear-gradient(90deg, #ffc837 0%, #ff8008 100%);
        color: #fff !important;
    }
    .btn-teal {
        background: linear-gradient(90deg, #11998e 0%, #38ef7d 100%);
        color: #fff !important;
        border: none;
    }
    .btn-teal:hover, .btn-teal:focus {
        background: linear-gradient(90deg, #38ef7d 0%, #11998e 100%);
        color: #fff !important;
    }

    @@media (min-width: 768px) {
        .custom-margin {
            margin-left: 150px;
        }

        .custom-width {
            width: 800px;
        }
    }
</style>

<div class="dashboard-bg w-100 min-vh-100">
    <div class="mt-3 d-flex justify-content-center align-items-center">
        <section class="shadow-lg rounded-4 p-4 custom-width">
            <h3>DASHBOARD</h3>
            <div class="row g-4 justify-content-center">
                <div class="col-md-3 col-6 d-flex justify-content-center">
                    <a href="/Dashboard/Products" class="btn btn-gradient w-100 p-3 scale-hover btn-dashboard text-center">
                        <i class="bi bi-bar-chart-fill mb-2"></i> 
                        Total <br/> Products
                    </a>
                </div>
                <div class="col-md-3 col-6 d-flex justify-content-center">
                    <a href="/Dashboard/Users" class="btn btn-orange w-100 p-3 scale-hover btn-dashboard text-center">
                         <i class="bi bi-receipt mb-2"></i>
                        Total <br/> Users
                    </a>
                </div>
                <div class="col-md-3 col-6 d-flex justify-content-center">
                    <a href="/Dashboard/Stocks" class="btn btn-teal w-100 p-3 scale-hover btn-dashboard text-center">
                        Top <br/> Stocks
                    </a>
                </div>
            </div>
        </section>
    </div>
</div>




