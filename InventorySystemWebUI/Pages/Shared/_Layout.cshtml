@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isIndexPage = string.Equals(currentPage, "/Index", StringComparison.OrdinalIgnoreCase);
    var successCheckout = string.Equals(currentPage, "/SuccessCheckout", StringComparison.OrdinalIgnoreCase);
    var isSessionExpiredPage = string.Equals(currentPage, "/SessionExpired",
                                        StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Makachi Service</title>
    <script type="importmap"></script>
    <link rel="shortcut icon" href="http://placehold.it/64.png/000/fff">
    <link rel="apple-touch-icon" sizes="144x144" href="http://placehold.it/144.png/000/fff">
    <link rel="apple-touch-icon" sizes="114x114" href="http://placehold.it/114.png/000/fff">
    <link rel="apple-touch-icon" sizes="72x72" href="http://placehold.it/72.png/000/fff">
    <link rel="apple-touch-icon" sizes="57x57" href="http://placehold.it/57.png/000/fff">
    <link href="~/assets/css/lib/calendar2/semantic.ui.min.css" rel="stylesheet">
    <link href="~/assets/css/lib/calendar2/pignose.calendar.min.css" rel="stylesheet">
    <link href="~/assets/css/lib/chartist/chartist.min.css" rel="stylesheet">
    <link href="~/assets/css/lib/font-awesome.min.css" rel="stylesheet">
    <link href="~/assets/css/lib/themify-icons.css" rel="stylesheet">
    <link href="~/assets/css/lib/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/assets/css/lib/owl.theme.default.min.css" rel="stylesheet" />
    <link href="~/assets/css/lib/weather-icons.css" rel="stylesheet" />
    <link href="~/assets/css/lib/menubar/sidebar.css" rel="stylesheet">
    <link href="~/assets/css/lib/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/css/lib/helper.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
       integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    @if (!isIndexPage && !isSessionExpiredPage)
    {
        <header>
            <div class="sidebar sidebar-hide-to-small sidebar-shrink sidebar-gestures">
            <div class="nano">
                <div class="nano-content">
                    <ul class="mt-4">
                        <div class="logo"><a href="/Home"><img src="~/assets/images/makachi.png" alt="" 
                            width="100" height="100" /><span>Makachi</span></a>
                        </div>

                        @await Component.InvokeAsync("ApiData")

                        <li>
                            <a class="sidebar-sub-toggle">
                                <i class="fa fa-boxes-stacked"></i>
                                Products <span class="sidebar-collapse-icon ti-angle-down"></span>
                            </a>
                            <ul>
                                <li><a asp-page ="/Module/Product/CreateCategory">Create Category</a></li>
                                <li><a asp-page="/Module/Product/CategoryList">Category List</a></li>
                                <li><a asp-page="/Module/Product/CreateProduct">Create Product</a></li>
                                <li><a asp-page="/Module/Product/ProductList">Product List</a></li>
                            </ul>
                        </li>
                        <li>
                            <a class="sidebar-sub-toggle">
                                <i class="fa fa-warehouse"></i>
                                Stock <span class="sidebar-collapse-icon ti-angle-down"></span>
                            </a>
                            <ul>
                                <li><a asp-page="/Module/Stock/ProductsStock">Product Stock</a></li>
                                <li><a asp-page="/Module/Stock/StockList">Stock List</a></li>
                            </ul>
                        </li>
                        <li>
                            <a class="sidebar-sub-toggle">
                                <i class="fa fa-cash-register"></i>
                                Point of Sale <span class="sidebar-collapse-icon ti-angle-down"></span>
                            </a>
                            <ul>
                                <li><a asp-page="/Module/Sales/CreateSale">Sales</a></li>
                            </ul>
                        </li>
                        <li>
                            <a class="sidebar-sub-toggle">
                                <i class="fa fa-chart-line"></i>
                                Analytics <span class="sidebar-collapse-icon ti-angle-down"></span>
                            </a>
                        <ul>
                            <li><a asp-page="/Module/Analytics/ViewInventory">View Inventory</a></li>
                        </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </div>


        <div class="header">
            <div class="">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="float-left">
                            <div class="hamburger sidebar-toggle">
                                <span class="line"></span>
                                <span class="line"></span>
                                <span class="line"></span>
                            </div>
                        </div>
                        <div class="float-right">
                            <ul>
                                <li class="header-icon dib">
                                    @await Component.InvokeAsync("FetchName")
                                    <div class="drop-down dropdown-profile">
                                        <div class="dropdown-content-heading">
                                            <span class="text-left">Setup</span>
                                        </div>
                                        <div class="dropdown-content-body">
                                            <ul>
                                                <li>
                                                    <a asp-page="/ChangePassword">
                                                        <i class="fa fa-key"></i> <span>Change Password</span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-page="/GenerateProductBarcode">
                                                        <i class="fa fa-barcode"></i> <span>Generate Product Barcode</span>
                                                    </a>
                                                </li>
                                                <li><a asp-page="/Index"><i class="ti-power-off"></i> <span>Logout</span></a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    }

    <div class="container-fluid" style="min-height: 100vh; width: 100%; display: flex; flex-direction: column;">
        <main role="main" class="ms-5" style="flex: 1 0 auto;">
            @RenderBody()
        </main>
    </div>
    
    <footer class="" style="flex-shrink: 0;">
        <p style="font-weight:bolder; font-size:18px;">
            &copy; @DateTime.Now.Year 4im digitals. All rights reserved.
        </p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/lib/jquery.min.js"></script>
    <script src="~/assets/js/lib/jquery.nanoscroller.min.js"></script>
    <script src="~/assets/js/lib/menubar/sidebar.js"></script>
    <script src="~/assets/js/lib/preloader/pace.min.js"></script>
    <script src="~/assets/js/lib/calendar-2/moment.latest.min.js"></script>
    <script src="~/assets/js/lib/calendar-2/semantic.ui.min.js"></script>
    <script src="~/assets/js/lib/calendar-2/prism.min.js"></script>
    <script src="~/assets/js/lib/calendar-2/pignose.calendar.min.js"></script>
    <script src="~/assets/js/lib/calendar-2/pignose.init.js"></script>
    <script src="~/assets/js/lib/weather/jquery.simpleWeather.min.js"></script>
    <script src="~/assets/js/lib/weather/weather-init.js"></script>
    <script src="~/assets/js/lib/circle-progress/circle-progress.min.js"></script>
    <script src="~/assets/js/lib/circle-progress/circle-progress-init.js"></script>
    <script src="~/assets/js/lib/chartist/chartist.min.js"></script>
    <script src="~/assets/js/lib/chartist/chartist-init.js"></script>
    <script src="~/assets/js/lib/sparklinechart/jquery.sparkline.min.js"></script>
    <script src="~/assets/js/lib/sparklinechart/sparkline.init.js"></script>
    <script src="~/assets/js/lib/owl-carousel/owl.carousel.min.js"></script>
    <script src="~/assets/js/lib/owl-carousel/owl.carousel-init.js"></script>
    <script src="~/assets/js/scripts.js"></script>
   
    <!-- scripit init-->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
