@page
@model InventorySystemWebUI.Pages.IndexModel
@{
    ViewData["Title"] = "Index Page";
}

<style>
    input.form-control {
        border-radius: 5px; /* Rounded corners */
        border: 1px solid #ced4da; /* Default Bootstrap border color */
        transition: border-color 0.3s ease; /* Smooth transition for border color */
    }

    input.form-control:hover {
        border-color: #007bff; /* Matches the Bootstrap btn-primary color */
        border-width: 2px; /* Optional: Make the border slightly thicker */
    }
</style>

<div class="bg-light d-flex flex-column align-items-center justify-content-center" style="min-height: 100vh;">
    <input type="hidden" value="@Model.ResponseModel.Status" id="status"/>
    <input type="hidden" value="@Model.ResponseModel.Description" id="description"/>

    <div class="card shadow-lg p-4" style="max-width: 500px; width: 100%;  border-radius:50px;">
        <h4 class="text-center mb-4 text-primary">REGISTER ACCOUNT</h4>
        <hr class="text-primary"/>
        <form method="post">
            <div class="form-group">
                <input type="text" class="form-control" id="username" placeholder="Username" asp-for="User.UserName" value="">
                <span class="text-danger" asp-validation-for="User.UserName"></span>
            </div>

            <div class="form-group">
                <input type="email" class="form-control" id="email" placeholder="Email" asp-for="User.Email" value="">
                <span class="text-danger" asp-validation-for="User.Email"></span>
            </div>

            <div class="form-group">
                <input type="number" class="form-control" id="phonenumber" placeholder="Phone number" asp-for="User.Phonenumber" value="">
                <span class="text-danger" asp-validation-for="User.Phonenumber"></span>
            </div>

            <div class="form-group">
                <input type="password" class="form-control" id="password" placeholder="Password" asp-for="User.Password" value="">
                <span class="text-danger" asp-validation-for="User.Password"></span>
            </div>

            <div class="form-group">
                <input type="password" class="form-control" id="confirmpassword" placeholder="Confirm Password" asp-for="User.ConfirmPassword" value="">
                <span class="text-danger" asp-validation-for="User.ConfirmPassword"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block" hidden id="post">Submit</button>
            <button type="button" class="btn btn-primary btn-block" id="check">Submit</button>
        </form>
        <div class="mt-3 text-center">
            <p class="mb-0">
                Already have an account?
                <a class="text-primary font-weight-bold" asp-page="/Login">Sign in</a>
            </p>
        </div>
    </div>
    <div class="mt-3 text-center"> 
       <p class="text-muted">Powered by <span class="text-primary">4im digitals</span></p> 
    </div> 
</div>

@section Scripts {
      <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
      <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/typeScripts/test.js" asp-append-version="true"></script>
}








