@page
@model InventorySystemWebUI.Pages.SignUpModel
@{
    ViewData["Title"] = "Sign Up";
}

<link href="https://fonts.googleapis.com/css?family=Inter:400,600&display=swap" rel="stylesheet" />
<style>
    html, body {
        height: 100vh;
        width: 100vw;
        margin: 0 !important;
        padding: 0 !important;
        overflow-x: hidden;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: none;
    }

    .login-card {
        position: relative;
        z-index: 1;
        background: rgba(255,255,255,0.85);
        border-radius: 24px;
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.18);
        max-width: 400px;
        width: 100%;
        padding: 2.5rem 2rem 2rem 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.25);
    }

    .login-card h4 {
        font-weight: 600;
        letter-spacing: 1px;
        color: #2563eb;
        margin-bottom: 1.5rem;
    }

    .form-group {
        position: relative;
        margin-bottom: 1.2rem;
    }

    .form-group .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #b0b0b0;
        font-size: 1.1rem;
        pointer-events: none;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 0.75rem 0.75rem 2.5rem;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background: #f9fafb;
        font-size: 1rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
        box-shadow: none;
    }

    .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 2px rgba(37,99,235,0.15);
        background: #fff;
    }

    .btn-primary {
        width: 100%;
        padding: 0.75rem;
        border-radius: 8px;
        background: linear-gradient(90deg, #2563eb 0%, #1e40af 100%);
        border: none;
        color: #fff;
        font-weight: 600;
        font-size: 1.1rem;
        letter-spacing: 0.5px;
        box-shadow: 0 2px 8px 0 rgba(37,99,235,0.10);
        transition: background 0.2s, box-shadow 0.2s;
    }

    .btn-primary:hover, .btn-primary:focus {
        background: linear-gradient(90deg, #1e40af 0%, #2563eb 100%);
        box-shadow: 0 4px 16px 0 rgba(37,99,235,0.15);
    }

    .text-link {
        color: #2563eb;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s;
    }

    .text-link:hover {
        color: #1e40af;
        text-decoration: underline;
    }

    @@media (max-width: 1200px) {
        .form-wrapper {
            margin-left: 80px;
            max-width: 480px;
        }
    }

    @@media (max-width: 992px) {
        .form-wrapper {
            margin-left: 60px;
            max-width: 440px;
        }
    }

    @@media (max-width: 768px) {
        .form-wrapper {
            margin-left: 50px;
            max-width: 400px;
        }
    }

    @@media (max-width: 576px) {
        .form-wrapper {
            margin-left: 0;
            padding-left: 1rem;
            padding-right: 1rem;
            max-width: 100%;
        }
    }
</style>

<div class="container-fluid px-2 ms-4">
    <div class="row">
        <div class="col-12 px-3 px-sm-4 px-md-5 px-lg-5 px-xl-5 ms-2 ms-sm-3 ms-md-4 ms-lg-5 ms-xl-5">
            <div class="form-wrapper mx-auto" style="max-width: 500px; margin-left: 200px;">
                <section class="card p-4 shadow-sm mt-4">
                    <h3 class="mb-4 text-center">CREATE ACCOUNT</h3>
                    <form method="post" autocomplete="off">
                        <input type="hidden" value="@Model.ResponseModel.Status" id="status" />
                        <input type="hidden" value="@Model.ResponseModel.Description" id="description" />

                        <div class="form-group mb-3">
                            <label for="username" class="form-label">Username</label>
                            <input type="text" class="form-control" id="username" placeholder="Username" asp-for="User.UserName" autocomplete="username">
                            <span class="text-danger" asp-validation-for="User.UserName"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" placeholder="Email" asp-for="User.Email" autocomplete="email">
                            <span class="text-danger" asp-validation-for="User.Email"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label for="phonenumber" class="form-label">Phone Number</label>
                            <input type="number" class="form-control" id="phonenumber" placeholder="Phone number" asp-for="User.Phonenumber">
                            <span class="text-danger" asp-validation-for="User.Phonenumber"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" class="form-control" id="password" placeholder="Password" asp-for="User.Password" autocomplete="new-password">
                            <span class="text-danger" asp-validation-for="User.Password"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label for="confirmpassword" class="form-label">Confirm Password</label>
                            <input type="password" class="form-control" id="confirmpassword" placeholder="Confirm Password" asp-for="User.ConfirmPassword" autocomplete="new-password">
                            <span class="text-danger" asp-validation-for="User.ConfirmPassword"></span>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary d-none" id="post">Submit</button>
                            <button type="button" class="btn btn-primary" id="check">Submit</button>
                        </div>
                    </form>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/typeScripts/test.js" asp-append-version="true"></script>
}
