@page
@model InventorySystemWebUI.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}


<style>
    @@media (min-width: 768px) {
        .custom-margin {
            margin-left: 150px;
        }

        .custom-width {
            width: 650px;
        }
    }
</style>

<div class="container-fluid px-1 custom-margin">
    <div class="content-body container">
        <div class="content-header">
            <div class="row mb-2 align-items-center">
                <div class="col-md-8 col-12 d-flex breadcrumb-new">
                    <h3 class="content-header-title mb-0 ms-5">CHANGE PASSWORD</h3>
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/Home" class="ms-2">Home</a></li>
                    </ol>
                </div>
            </div>
        </div>

        <section class="card custom-width">
            <form method="post">
                <input type="hidden" value="@Model.ResponseModel.Status" id="status" />
                <input type="hidden" value="@Model.ResponseModel.Description" id="description" />
                <div class="card-body">
                    <p class="text-danger" style="font-style:italic">Note:All items in <span class="text-danger"> *</span> are required</p>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Enter User Name <span class="text-danger">*</span></label>
                                <input type="text"
                                       class="form-control"
                                       id="username" asp-for="PasswordDetail.Username"/>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Current Password <span class="text-danger">*</span></label>
                                <Input type="password" class="form-control" id="currentpassword" asp-for="PasswordDetail.OldPassword"/>
                            </div>

                            <div class="form-group">
                                <label class="form-label">New Password <span class="text-danger">*</span></label>
                                <Input type="password" class="form-control" id="newpassword" asp-for="PasswordDetail.NewPassword"/>
                            </div>
                        </div>
                    </div>

                    <button type="button" class="btn btn-success btn-md mt-3 mb-3" style="margin-left:10px" id="hiddenSave"><i class="fa fa-exchange-alt"></i> Change</button>
                    <button type="submit" class="btn btn-success btn-md mt-3 mb-3" style="margin-left:10px" hidden id="saveBtn">
                        <i class="fa fa-exchange-alt"></i> Change Password
                    </button>
                </div>
            </form>
        </section>

    </div>
</div>

@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/typeScripts/changePassword.js" asp-append-version="true"></script>
}
