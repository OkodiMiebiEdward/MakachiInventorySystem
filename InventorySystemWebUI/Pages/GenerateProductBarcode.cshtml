@page
@model InventorySystemWebUI.Pages.GenerateProductBarcodeModel
@{
    ViewData["Title"] = "Generate Product Barcode";
}

<div style="margin-left:220px" class="mt-3 d-flex justify-content-center align-items-center">
    <div class="content-body container px-5">
        <div class="content-header">
            <div class="row content-header-left col-md-8 col-12 mb-2 breadcrumb-new align-items-center d-flex">
                <h3 class="content-header-title mb-0 me-3">GENERATE BARCODE</h3>
                <div class="">
                    <div class="">
                        <ol class="">
                            <li class="">
                                <a href="/Home">Home</a>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="card" style="width:1000px">
            <div class="p-1 card-body">
                <table class="datatable mb-4 ms-2 table table-responsive table-hover">
                    <thead class="">
                        <tr>
                            <th>Product Name</th>
                            <th>Description</th>
                            <th>BarCodeNumber</th>
                            <th>Generate Barcode</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Products)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.ProductDescription</td>
                                <td>@item.BarCodeNumber</td>
                                <td>
                                    <button type="button" class="btn btn-primary"
                                    onclick="printBarcodeWithBase64(
                                    '@item.BarCodeNumber',
                                    '@item.ProductName'.replace(/'/g, '\\\''),
                                    '@item.ProductDescription'.replace(/'/g, '\\\'')
                                    )">
                                        Print
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@section scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.datatable').DataTable();
        });

                function printBarcodeWithBase64(code, productName, productDescription) {
            fetch(`/GenerateProductBarcode?handler=GenerateBarcode&code=${encodeURIComponent(code)}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        var win = window.open('', '', 'width=400,height=250');
                        win.document.write(`
                            <div style="font-family:sans-serif; width:350px; border:1px solid #000; padding:10px; text-align:center;">
                                <div style="font-weight:bold; font-size:16px;">${productName}</div>
                                <div style="font-size:12px; margin-bottom:4px;">${productDescription}</div>
                                <img src="data:image/png;base64,${data.base64}" style="max-width:300px; margin:8px 0;" />
                                <div style="font-size:12px;">${code}</div>
                            </div>
                            <script>
                                window.onload = function() { window.print(); window.close(); }
                            <\/script>
                        `);
                    } else {
                        alert('Error: ' + (data.error || 'Unknown error'));
                    }
                });
        }
    </script>
}