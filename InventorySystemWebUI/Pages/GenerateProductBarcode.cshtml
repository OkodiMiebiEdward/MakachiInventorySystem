@page
@model InventorySystemWebUI.Pages.GenerateProductBarcodeModel
@{
    ViewData["Title"] = "Generate Product Barcode";
}

<style>
    @@media (min-width: 768px) {
        .custom-margin {
            margin-left: 150px;
        }

        .custom-width {
            width: 650px;
        }
    }
</style>

<div class="container-fluid px-1 custom-margin">
    <div class="content-body container">
        <div class="content-header">
            <div class="row mb-2 align-items-center">
                <div class="col-md-8 col-12 d-flex breadcrumb-new">
                    <h3 class="content-header-title mb-0 ms-5">GENERATE BARCODE</h3>
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/Home" class="ms-2">Home</a></li>
                    </ol>
                </div>
            </div>
        </div>

        <section class="card custom-width">
            <div class="p-1 card-body">
                <table class="datatable mb-4 ms-2 table table-responsive table-hover">
                    <thead class="">
                        <tr>
                            <th>Product Name</th>
                            <th>Description</th>
                            <th>Generate Barcode</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Products)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.ProductDescription</td>
                                <td>
                                    <button type="button" class="btn btn-primary"
                                    onclick="printBarcodeWithBase64(
                                    '@item.ProductName'.replace(/'/g, '\\\''),
                                    '@item.ProductDescription'.replace(/'/g, '\\\'')
                                    )">
                                        Print
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@section scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.datatable').DataTable();
        });

                function printBarcodeWithBase64(productName, productDescription) {
            fetch(`/GenerateProductBarcode?handler=GenerateBarcode&code=${productName}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        var win = window.open('', '', 'width=400,height=250');
                        win.document.write(`
                            <div style="font-family:sans-serif; width:350px; border:1px solid #000; padding:10px; text-align:center;">
                                <div style="font-weight:bold; font-size:16px;">${productName}</div>
                                <div style="font-size:12px; margin-bottom:4px;">${productDescription}</div>
                                <img src="data:image/png;base64,${data.base64}" style="max-width:300px; margin:8px 0;" />
                            </div>
                            <script>
                                window.onload = function() { window.print(); window.close(); }
                            <\/script>
                        `);
                    } else {
                        alert('Error: ' + (data.error || 'Unknown error'));
                    }
                });
        }
    </script>
}