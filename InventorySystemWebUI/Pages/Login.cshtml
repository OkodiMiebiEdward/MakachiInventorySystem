@page
@model InventorySystemWebUI.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<style>
    input.form-control {
        border-radius: 5px; /* Rounded corners */
        border: 1px solid #ced4da; /* Default Bootstrap border color */
        transition: border-color 0.3s ease; /* Smooth transition for border color */
    }

    input.form-control:hover {
        border-color: #007bff; /* Matches the Bootstrap btn-primary color */
        border-width: 2px; /* Optional: Make the border slightly thicker */
    }
</style>

<div class="bg-light d-flex flex-column align-items-center justify-content-center" style="min-height: 100vh;">
    <input type="hidden" value="@Model.ResponseModel.Status" id="status" />
    <input type="hidden" value="@Model.ResponseModel.Description" id="description" />
    <div class="card shadow-lg p-4" style="max-width: 500px; width: 100%; border-radius:50px;">
        <h4 class="text-center mb-4 text-primary">SIGN IN</h4>
        <form method="post">
            <div class="form-group">
                <input type="text" class="form-control" id="username" placeholder="Username" asp-for="@Model.User.UserName">
            </div>

            <div class="form-group">
                <input type="email" class="form-control" id="email" placeholder="Email" asp-for="@Model.User.Email">
            </div>

            <div class="form-group">
                <input type="password" class="form-control" id="password" placeholder="Password" asp-for="@Model.User.Password">
            </div>

            <button type="submit" class="btn btn-primary btn-block" hidden id="post">Sign me in</button>
            <button type="button" class="btn btn-primary btn-block" id="check">Sign me in</button>
        </form>

        <div class="mt-3 text-center">
            <p class="mb-0">
                Don't have an Account?
                <a class="text-primary font-weight-bold" href="/Index">Sign up</a>
            </p>
        </div>
    </div>
    <div class="mt-3 text-center"> 
        <p class="text-muted">Powered by <span class="text-primary">4im digitals</span></p> 
    </div>
</div>


@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/typeScripts/login.js" asp-append-version="true"></script>
}