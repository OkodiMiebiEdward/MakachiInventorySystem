@page
@model InventorySystemWebUI.Pages.Module.UserManagement.UserRolesListModel
@{
    ViewData["Title"] = "Users/Role List";
}

<div style="margin-left:220px" class="mt-3 d-flex justify-content-center align-items-center">
    <div class="content-body container px-5">
        <div class="content-header">
            <div class="row content-header-left col-md-8 col-12 mb-2 breadcrumb-new align-items-center d-flex">
                <h3 class="content-header-title mb-0 me-3">Users/Role List</h3>
                <div class="">
                    <div class="">
                        <ol class="">
                            <li class="">
                                <a href="/Home">Home</a>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="card" style="width:1000px">
            <div class="p-1 card-body">
                <a asp-page="/Module/UserManagement/CreateRole" class="btn btn-primary btn-md ms-5">Create New Role</a>
                <hr />
                <table class="mb-4 ms-2 table table-responsive table-hover">
                    <thead class="">
                        <tr>
                            <th>Name</th>
                            <th>Role</th>
                            <th>Edit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.UserRoleRecords)
                        {
                            <tr>
                                <td>@item.UserName</td>
                                <td>@item.Role</td>
                                <td><button class="btn btn-primary">Edit</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

    </div>
</div>