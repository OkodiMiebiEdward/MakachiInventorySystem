@page
@model InventorySystemWebUI.Pages.Module.UserManagement.UserRolesListModel
@{
    ViewData["Title"] = "Users/Role List";
}

<style>
    @@media (min-width: 768px) {
        .custom-margin {
            margin-left: 150px;
        }

        .custom-width {
            width: 600px;
        }
    }
</style>

<div class="container-fluid px-1 custom-margin">
    <div class="content-body container">
        <div class="content-header">
            <div class="row mb-2 align-items-center">
                <div class="col-md-8 col-12 d-flex breadcrumb-new">
                    <h3 class="content-header-title mb-0 ms-5">USERS/ROLE LIST</h3>
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/Home" class="ms-3">Home</a></li>
                    </ol>
                </div>
            </div>
        </div>

        <section class="card custom-width">
            <div class="card-body p-3">
                <div class="d-flex justify-content-start mb-3">
                    <a asp-page="/Module/UserManagement/AssignRole" class="btn btn-primary btn-md">Assign Role</a>
                </div>
                <hr />
                <div class="table-responsive">
                    <table class="datatable table table-hover mb-4">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Role</th>
                                <th>Edit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.UsersWithRoles)
                            {
                                <tr>
                                    <td>@user.UserName</td>
                                    <td>@string.Join(", ", user.Roles)</td>
                                    <td>
                                        @foreach (var role in user.Roles)
                                        {
                                            <a class="btn btn-primary btn-sm mb-1" href="/Module/UserManagement/AssignRole?name=@user.UserName&role=@role">Edit @role</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>
</div>


@section scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.datatable').DataTable();
        });
    </script>
}