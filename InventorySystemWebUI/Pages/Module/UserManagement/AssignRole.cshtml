@page
@model InventorySystemWebUI.Pages.Module.UserManagement.CreateUserModel
@{
    ViewData["Title"] = "Assign Roles To User";
}

<style>
    @@media (min-width: 768px) {
        .custom-margin {
            margin-left: 150px;
        }

        .custom-width {
            width: 650px;
        }
    }
</style>

<div class="container-fluid px-1 custom-margin">
    <div class="content-body container">
        <div class="content-header">
            <div class="row mb-2 align-items-center">
                <div class="col-md-8 col-12 d-flex breadcrumb-new">
                    <h3 class="content-header-title mb-0 ms-5">ASSIGN ROLES</h3>
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/Home" class="ms-2">Home</a></li>
                    </ol>
                </div>
            </div>
        </div>

        <section class="card custom-width">
            <form method="post">
                <input type="hidden" value="@Model.ResponseModel.Status" id="status" />
                <input type="hidden" value="@Model.ResponseModel.Description" id="description" />
                <input type="hidden" value="@Model.numCheck" />
                <div class="card-body">
                    <p class="text-danger fst-italic">Note: All items in <span class="text-danger">*</span> are required</p>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="form-label">User List <span class="text-danger">*</span></label>
                            <select class="form-select" asp-for="AssignRole.UserName" id="selectedUser"
                                    disabled="@(Model.numCheck == 1 ? "disabled" : null)">
                                <option selected value="">Select</option>
                                @foreach (var user in Model.Users)
                                {
                                    <option value="@user.UserName">@user.UserName</option>
                                }
                            </select>
                            @if (Model.numCheck == 1)
                            {
                                <input type="hidden" asp-for="AssignRole.UserName" value="@Model.AssignRole.UserName" />
                            }
                        </div>

                        <div class="form-group col-md-6">
                            <label class="form-label">Role List <span class="text-danger">*</span></label>
                            <select class="form-select" asp-for="AssignRole.Role" id="selectedRole"
                                    disabled="@(Model.numCheck == 1 ? "disabled" : null)">
                                <option selected value="">Select</option>
                                @foreach (var role in Model.Roles)
                                {
                                    <option value="@role.Name">@role.Name</option>
                                }
                            </select>
                            @if (Model.numCheck == 1)
                            {
                                <input type="hidden" asp-for="AssignRole.Role" value="@Model.AssignRole.Role" />
                            }
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-3 mb-3">
                        <button type="button" class="btn btn-success btn-md" id="hiddenSave"
                                disabled="@(Model.numCheck == 1 ? "disabled" : null)">
                            <i class="fa fa-save"></i> Save
                        </button>
                        <button type="submit" class="btn btn-success btn-md" hidden id="saveBtn">
                            <i class="fa fa-save"></i> Save
                        </button>
                        <a href="/Module/UserManagement/AssignRole" class="btn btn-warning btn-md">
                            <i class="fa fa-refresh"></i> Refresh
                        </a>
                        <a href="/Module/UserManagement/UserRolesList" class="btn btn-primary btn-md">
                            <i class="fa fa-eye"></i> View Saved Records
                        </a>
                        @if (Model.numCheck == 1)
                        {
                            <button type="submit" class="btn btn-danger btn-md" asp-page-handler="delete">
                                <i class="fa fa-trash"></i> Remove Role
                            </button>
                        }
                    </div>
                </div>
            </form>
        </section>
    </div>
</div>


@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/typeScripts/assignUserRoles.js" asp-append-version="true"></script>
}

