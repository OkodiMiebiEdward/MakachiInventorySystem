@page
@model InventorySystemWebUI.Pages.Module.UserManagement.CreateRoleModel
@{
    ViewData["Title"] = "Create New Role";
}

<div class="container-fluid px-1 ms-3">
    <input hidden value="@Model.CanDelete" />
    <div class="content-body container">
        <div class="content-header">
            <div class="row mb-2 align-items-center">
                <div class="col-12 col-md-8 d-flex breadcrumb-new">
                    <h3 class="content-header-title mb-0 me-3">CREATE NEW ROLE</h3>
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/Home">Home</a>
                        </li>
                    </ol>
                </div>
            </div>
        </div>

        <section class="card">
            <form method="post">
                <input type="hidden" value="@Model.ResponseModel.Status" id="status" />
                <input type="hidden" value="@Model.ResponseModel.Description" id="description" />
                <div class="card-body">
                    <p class="text-danger fst-italic">Note: All items in <span class="text-danger">*</span> are required</p>
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Enter Role Name <span class="text-danger">*</span></label>
                                <input type="text"
                                       class="form-control"
                                       asp-for="Role.Name"
                                       id="rolename"
                                       readonly="@(Model.CanDelete == "Yes" ? "readonly" : null)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Role Description <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="4" placeholder="Enter detailed description here" asp-for="Role.RoleDescription" id="textDescription"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-3 mb-3">
                        <button type="button" class="btn btn-success" id="hiddenSave"><i class="fa fa-save"></i> Save</button>
                        <button type="submit" class="btn btn-success" hidden id="saveBtn"><i class="fa fa-save"></i> Save</button>
                        <a href="/Module/UserManagement/CreateRole" class="btn btn-warning"><i class="fa fa-refresh"></i> Refresh</a>
                        <a href="/Module/UserManagement/RoleList" class="btn btn-primary"><i class="fa fa-eye"></i> View Saved Records</a>
                        <button type="submit"
                                class="btn btn-danger"
                                hidden="@(Model.CanDelete == "No" ? "hidden" : null)"
                                asp-page-handler="Delete">
                            <i class="fa fa-trash"></i> Delete
                        </button>
                    </div>
                </div>
            </form>
        </section>
    </div>
</div>


@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/typeScripts/createRole.js" asp-append-version="true"></script>
}

