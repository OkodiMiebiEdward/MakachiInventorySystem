@page
@model InventorySystemWebUI.Pages.Module.UserManagement.CreateRoleModel
@{
    ViewData["Title"] = "Create New Role";
}

<div style="margin-left:220px" class="mt-3 d-flex justify-content-center align-items-center">
    <input hidden value="@Model.CanDelete"/>
    <div class="content-body container px-5">
        <div class="content-header">
            <div class="row content-header-left col-md-8 col-12 mb-2 breadcrumb-new align-items-center d-flex">
                <h3 class="content-header-title mb-0 me-3">CREATE NEW ROLE</h3>
                <div class="">
                    <div class="">
                        <ol class="">
                            <li class="">
                                <a href="/Home">Home</a>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="card" style="width:1000px">
            <form method="post">
                <input type="hidden" value="@Model.ResponseModel.Status" id="status" />
                <input type="hidden" value="@Model.ResponseModel.Description" id="description" />
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Enter Role Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" asp-for="Role.Name" id="rolename" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">Role Description<span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="4" cols="100" placeholder="Enter detailed description here" asp-for="Role.RoleDescription" id="textDescription"></textarea>
                            </div>
                        </div>
                    </div>

                    <button type="button" class="btn btn-primary btn-md mt-3 mb-3" style="margin-left:10px" id="hiddenSave"><i class="fa fa-save"></i> Save</button>
                    <button type="submit" class="btn btn-primary btn-md mt-3 mb-3" style="margin-left:10px" hidden id="saveBtn"><i class="fa fa-save"></i> Save</button>
                    <button type="submit"
                            class="btn btn-danger btn-md mt-3 mb-3"
                            style="margin-left:10px"
                            hidden="@(Model.CanDelete == "No" ? "hidden" : null)"
                            asp-page-handler="Delete">
                       <i class="fa fa-trash"></i> Delete
                    </button>
                </div>
            </form>
        </section>
       
    </div>
</div>

@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/typeScripts/createRole.js" asp-append-version="true"></script>
}

