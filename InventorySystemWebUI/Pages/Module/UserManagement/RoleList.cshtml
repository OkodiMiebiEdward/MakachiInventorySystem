@page
@model InventorySystemWebUI.Pages.Module.UserManagement.RoleListModel
@{
    ViewData["Title"] = "Role List";
}


<div style="margin-left:220px" class="mt-3 d-flex justify-content-center align-items-center">
    <div class="content-body container px-5">
        <div class="content-header">
            <div class="row content-header-left col-md-8 col-12 mb-2 breadcrumb-new align-items-center d-flex">
                <h3 class="content-header-title mb-0 me-3">ROLE LIST</h3>
                <div class="">
                    <div class="">
                        <ol class="">
                            <li class="">
                                <a href="/Home">Home</a>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="card" style="width:1000px">
                <div class="p-1 card-body">
                    <a asp-page="/Module/UserManagement/CreateRole" class="btn btn-primary btn-md ms-5">Create New Role</a>
                    <hr />
                    <table class="datatable mb-4 ms-2 table table-responsive table-hover">
                        <thead class="">
                            <tr>
                                <th>Role</th>
                                <th>Details</th>
                                <th>Edit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Roles)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.RoleDescription</td>
                                    <td><a class="btn btn-primary text-white" href="/Module/UserManagement/CreateRole?name=@item.Name">Edit</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
        </section>

    </div>
</div>

@section scripts{
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.datatable').DataTable();
        });
    </script>
}