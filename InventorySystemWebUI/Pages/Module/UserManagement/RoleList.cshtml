@page
@model InventorySystemWebUI.Pages.Module.UserManagement.RoleListModel
@{
    ViewData["Title"] = "Role List";
}

<style>
    @@media (min-width: 768px) {
        .custom-margin {
            margin-left: 150px;
        }

        .custom-width {
            width: 600px;
        }
    }
</style>

<div class="container-fluid px-1 custom-margin">
    <div class="row">
        <main class="col-12 col-md-9 col-xl-10 mt-3 d-flex justify-content-center align-items-center">
            <div class="content-body container px-3 px-md-5">
                <div class="content-header">
                    <div class="row mb-2 align-items-center">
                        <div class="col-12 col-md-8 d-flex breadcrumb-new">
                            <h3 class="content-header-title mb-0 ms-5">ROLE LIST</h3>
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/Home" class="ms-3">Home</a></li>
                            </ol>
                        </div>
                    </div>
                </div>

                <section class="card custom-width">
                    <div class="card-body p-1">
                        <a asp-page="/Module/UserManagement/CreateRole" class="btn btn-primary btn-md ms-md-5">Create New Role</a>
                        <hr />
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Role</th>
                                        <th>Details</th>
                                        <th>Edit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Roles)
                                    {
                                        <tr>
                                            <td>@item.Name</td>
                                            <td>@item.RoleDescription</td>
                                            <td><a class="btn btn-primary text-white" href="/Module/UserManagement/CreateRole?name=@item.Name">Edit</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </div>
</div>


@section scripts{
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.datatable').DataTable();
        });
    </script>
}