@page
@model InventorySystemWebUI.Pages.Module.Stock.StockListModel
@{
    ViewData["Title"] = "Stock List";
}

<div style="margin-left:220px" class="mt-3 d-flex justify-content-center align-items-center">
    <div class="content-body container px-5">
        <div class="content-header">
            <div class="row content-header-left col-md-8 col-12 mb-2 breadcrumb-new align-items-center d-flex">
                <h3 class="content-header-title mb-0 me-3">STOCK LIST</h3>
                <div class="">
                    <div class="">
                        <ol class="">
                            <li class="">
                                <a href="/Home">Home</a>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
        
        <section class="card" style="width:1000px">
                <div class="p-1 card-body">
                    <a asp-page="/Module/Stock/ProductsStock" class="btn btn-primary btn-md ms-5">Create New Stock</a>
                    <hr />
                    <table class="datatable mb-4 ms-2 table table-responsive table-hover">
                        <thead class="">
                            <tr>
                                <th>Product Name</th>
                                <th>QuantityInStock</th>
                                <th>Cost per unit price</th>
                                <th>Selling unit price</th>
                                <th>Discount</th>
                                <th>Created At</th>
                                <th>Edit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stock in Model.Stocks)
                            {
                                <tr>
                                    <td>@stock.ProductName</td>
                                    <td>@stock.QuantityInStock</td>
                                    <td>@stock.CostUnitPrice</td>
                                    <td>@stock.SellingUnitPrice</td>
                                    <td>@stock.Discount</td>
                                    <td>@stock.CreatedAt?.ToString("dd-MM-yyyy")</td>
                                    <td><a class="btn btn-primary text-white" href="/Module/Stock/ProductsStock?id=@stock.Id">Edit</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
        </section>

    </div>
</div>

@section scripts{
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.datatable').DataTable();
        });
    </script>
}
