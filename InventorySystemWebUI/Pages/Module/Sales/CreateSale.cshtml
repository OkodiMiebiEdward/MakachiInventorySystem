@page
@model InventorySystemWebUI.Pages.Module.Sales.CreateSaleModel
@{
    ViewData["Title"] = "Create Sale";
}

<div style="margin-left:220px" class="d-flex justify-content-center align-items-center ">
    <div class="content-body container px-5">
        <div class="content-header">
            <div class="row content-header-left col-md-8 col-12 mb-2 breadcrumb-new align-items-center d-flex">
                <h3 class="content-header-title mb-0 me-3">CREATE SALE</h3>
                <div class="">
                    <div class="">
                        <ol class="">
                            <li class="">
                                <a href="/Home">Home</a>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="card" style="width:1000px">
            <form method="post">
                <input type="hidden" value="@Model.ResponseModel.Status" id="status" />
                <input type="hidden" value="@Model.ResponseModel.Description" id="description" />

                <div class="card-body">
                    <p class="text-danger" style="font-style:italic">Note:All items in <span class="text-danger"> *</span> are required</p>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Enter Barcode number <span class="text-danger">*</span></label>
                                <input class="form-control" id="barcodenumber" type="text" onchange="getDataFromModal(1)" />
                            </div>
                        </div>

                        <div class="form-group col-md-3">
                            <label class="form-label">Price<span class="text-danger">*</span></label>
                            <input class="form-control" id="price" type="number" />
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Quantity<span class="text-danger">*</span></label>
                                <input class="form-control" id="quantity" type="number" />
                            </div>
                        </div>

                        <div class="form-group col-md-3">
                            <label class="form-label">Discount <span class="text-danger">*</span></label>
                            <input class="form-control" id="discount" type="number" value="@Model.Product.Discount" readonly/>
                        </div>
                    </div>

                    <button type="button" class="btn btn-success btn-md mt-3 mb-3" style="margin-left:10px" id="hiddenSave" onclick="addToCart()"><i class="fa fa-save"></i> Add To Cart</button>
                    @* <button type="submit" class="btn btn-success btn-md mt-3 mb-3" style="margin-left:10px" hidden id="saveBtn"><i class="fa fa-save"></i> Save</button> *@
                    <a href="/Module/Sales/CreateSales" class="btn btn-warning btn-md mt-3 mb-3" style="margin-left:10px" id=""><i class="fa fa-refresh"></i> Refresh</a>
                </div>

                <div class="actionTable" style="display: none;">
                    <table id="saleTable">
                        <thead>
                            <tr>
                                <th>Quantity</th>
                                <th>Price Sold</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div class="modal fade" id="compmodal"
                     data-keyboard="false" data-backdrop="static">
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/typeScripts/createSales.js" asp-append-version="true"></script>
}
