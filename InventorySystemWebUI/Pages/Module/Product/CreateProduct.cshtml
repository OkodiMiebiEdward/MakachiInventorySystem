@page
@model InventorySystemWebUI.Pages.Module.Product.CreateProductModel
@{
    ViewData["Title"] = "Create Product";
}

<div style="margin-left:220px" class="d-flex justify-content-center align-items-center">
    <div class="content-body container px-5">
        <div class="content-header">
            <div class="row content-header-left col-md-8 col-12 mb-2 breadcrumb-new align-items-center d-flex">
                <h3 class="content-header-title mb-0 me-3">CREATE NEW PRODUCT</h3>
                <div class="">
                    <div class="">
                        <ol class="">
                            <li class="">
                                <a href="/Home">Home</a>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="card" style="width:1000px">
            <form method="post">
                <input type="hidden" value="@Model.ResponseModel.Status" id="status" />
                <input type="hidden" value="@Model.ResponseModel.Description" id="description" />
                <div class="card-body">
                    <p class="text-danger" style="font-style:italic">Note:All items in <span class="text-danger"> *</span> are required</p>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Enter Product Name <span class="text-danger">*</span></label>
                                <input type="text"
                                       class="form-control"
                                       asp-for="Product.ProductName"
                                       id="productname" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">Role Description <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="4" cols="100" placeholder="Enter detailed description here" asp-for="Product.ProductName" id="textDescription"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </section>

    </div>
</div>