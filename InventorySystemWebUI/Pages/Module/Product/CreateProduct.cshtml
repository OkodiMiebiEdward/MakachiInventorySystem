@page
@model InventorySystemWebUI.Pages.Module.Product.CreateProductModel
@{
    ViewData["Title"] = "Create Product";
}

<div style="margin-left:220px" class="d-flex justify-content-center align-items-center">
    <div class="content-body container px-5">
        <div class="content-header">
            <div class="row content-header-left col-md-8 col-12 mb-2 breadcrumb-new align-items-center d-flex">
                <h3 class="content-header-title mb-0 me-3">CREATE NEW PRODUCT</h3>
                <div class="">
                    <div class="">
                        <ol class="">
                            <li class="">
                                <a href="/Home">Home</a>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="card" style="width:1000px">
            <form method="post">
                <input type="hidden" value="@Model.ResponseModel.Status" id="status" />
                <input type="hidden" value="@Model.ResponseModel.Description" id="description" />
                <input hidden value="@Model.CanDelete" />
                <input hidden asp-for="@Model.Product.Id"/>
                <div class="card-body">
                    <p class="text-danger" style="font-style:italic">Note:All items in <span class="text-danger"> *</span> are required</p>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label">Enter Product Name <span class="text-danger">*</span></label>
                                <input type="text"
                                       class="form-control"
                                       asp-for="Product.ProductName"
                                       id="productname" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label">Enter Product Description <span class="text-danger">*</span></label>
                                <input class="form-control" placeholder="Enter detailed description here" asp-for="Product.ProductDescription" id="productDescription"/>
                            </div>
                        </div>

                        <div class="form-group col-md-4">
                            <label class="form-label">Category List <span class="text-danger">*</span></label>
                            <select class="form-select"
                                    id="selectedCategory" asp-for="Product.CategoryId">
                                <option selected value="">Select</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label">Price<span style="color: red"> *</span></label>
                                <input type="number" id="price" class="form-control" asp-for="Product.Price" value="@Model.Product.Price" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label">SKU<span style="color: red"> *</span></label>
                                <div class="input-group">
                                    <input id="sku" class="form-control" asp-for="Product.SKU" value="@Model.Product.SKU"/>
                                    <button class="btn btn-primary" type="button" onclick="generate(0)">Generate</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label">Bar code Number<span style="color: red"> *</span></label>
                                <div class="input-group">
                                    <input id="barcodenumber" class="form-control" asp-for="Product.BarCodeNumber" value="@Model.Product.BarCodeNumber"/>
                                    <button class="btn btn-primary" type="button" onclick="generate(1)">Generate</button>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="row mt-3">
                        <div class="input-group mb-3 col-md-4">
                            <button class="btn btn-primary btn-large" id="btnaddmorerow" type="button" onclick="addTableRow()">Add New Role</button>
                        </div>
                    </div>

                    @if (Model.Product.Variants is not null)
                    {
                        @if(Model.Product.Variants.Count > 0)
                        {
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="table-responsive">
                                        <table id="" class="table table-responsive">
                                            <thead class="table">
                                                <tr>
                                                    <th style="text-align:center;padding:5px; border:1px solid lightgrey; "> S/N </th>
                                                    <th style="text-align:center;padding:5px; border:1px solid lightgrey; "> Size <span style="color:red">*</span> </th>
                                                    <th style="text-align:center;padding:5px; border:1px solid lightgrey; "> Color <span style="color:red">*</span></th>
                                                </tr>
                                            </thead>
                                            <tbody id="variantsTableBody" class="tabletb">
                                                @for (int i = 0; i < Model.Product.Variants.Count; i++)
                                                {
                                                    var items = Model.Product.Variants[i];
                                                    <tr>
                                                        <td class="@i">
                                                            @(i + 1)
                                                        </td>
                                                        <td style="padding:10px; border:1px solid lightgrey;">
                                                            <input type="text" class="form-control @i" value="@items.Size" asp-for="Product.Variants[i].Size">
                                                        </td>
                                                        <td style="padding:10px; border:1px solid lightgrey;">
                                                            <input type="text" class="form-control code @i" value="@items.Color" asp-for="Product.Variants[i].Color">
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                        
                    }
                    

                    <button type="button" class="btn btn-success btn-md mt-3 mb-3" style="margin-left:10px" id="hiddenSave"><i class="fa fa-save"></i> Save</button>
                    <button type="submit" class="btn btn-success btn-md mt-3 mb-3" style="margin-left:10px" hidden id="saveBtn"><i class="fa fa-save"></i> Save</button>
                    <a href="/Module/Product/CreateProduct" class="btn btn-warning btn-md mt-3 mb-3" style="margin-left:10px" id=""><i class="fa fa-refresh"></i> Refresh</a>
                    <a href="/Module/Product/ProductList" class="btn btn-primary btn-md mt-3 mb-3" style="margin-left:10px" id=""><i class="fa fa-eye"></i> View Saved Records</a>
                    <button type="submit"
                            class="btn btn-danger btn-md mt-3 mb-3"
                            style="margin-left:10px"
                            hidden="@(Model.CanDelete == "No" ? "hidden" : null)"
                            asp-page-handler="Delete">
                        <i class="fa fa-trash"></i> Delete
                    </button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/typeScripts/createProduct.js" asp-append-version="true"></script>
}